# ==========================================
# NetPulse - Git Ignore
# ==========================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Archivos generados
dist/
build/
coverage/
*.tsbuildinfo
.vite/
.next/
.turbo/

# Variables de entorno y secretos
.env
.env.*
!.env.example
!.env.*.example

# Bases de datos SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
*.sqlite3-shm
*.sqlite3-wal

# Datos persistentes
data/
storage/
backups/

# Logs
logs/
*.log

# Archivos temporales
tmp/
temp/
.cache/

# Archivos del sistema
.DS_Store
Thumbs.db
Desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Archivos locales de Docker
docker-compose.override.yml

# Certificados y claves privadas
*.pem
*.key
*.p12
*.pfx
